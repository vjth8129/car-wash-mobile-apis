NODE_ENV=development

PORT=5000

# Postgres connection string.
# - Running the API directly on the host (npm run dev) against docker-compose's postgres: use localhost:5442
# - Running the API itself inside docker-compose: the "api" service overrides this to host "postgres:5432"
DATABASE_URL=postgresql://postgres:postgres@localhost:5442/carwash

# JWT secrets - generate strong random values for production, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_RESET_SECRET=dev-reset-secret-change-me

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
RESET_TOKEN_EXPIRES_IN=30m

CORS_ORIGIN=http://localhost:3000

LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
FORGOT_PASSWORD_RATE_LIMIT_MAX=5

# Email provider: "console" logs the reset link (development), "smtp" sends real email
MAIL_PROVIDER=console
MAIL_FROM=no-reply@carwash.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
APP_PUBLIC_URL=http://localhost:3000
