NODE_ENV=test

PORT=5001

DATABASE_URL=postgresql://postgres:postgres@localhost:5442/carwash_test

JWT_ACCESS_SECRET=test-access-secret
JWT_REFRESH_SECRET=test-refresh-secret
JWT_RESET_SECRET=test-reset-secret

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
RESET_TOKEN_EXPIRES_IN=30m

CORS_ORIGIN=*

LOG_LEVEL=silent

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000
RATE_LIMIT_USER_MAX=20000
AUTH_RATE_LIMIT_MAX=10000
FORGOT_PASSWORD_RATE_LIMIT_MAX=10000
SIGNUP_RATE_LIMIT_MAX=10000

MAIL_PROVIDER=console
MAIL_FROM=no-reply@carwash.local
APP_PUBLIC_URL=http://localhost:3000

# Promotions are sent explicitly in tests (runDuePromotions), not by a background timer.
PROMOTION_POLL_MS=0
