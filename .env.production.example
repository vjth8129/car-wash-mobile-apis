# Copy to .env on the EC2 instance and fill in real values.
# NEVER commit the filled-in .env - it holds production secrets.

NODE_ENV=production
PORT=5000

# RDS endpoint - from the RDS console "Connectivity & security" tab. sslmode=require
# is recommended for RDS (it terminates TLS at the DB, independent of your VPC security groups).
DATABASE_URL=postgresql://carwash_app:REPLACE_WITH_REAL_PASSWORD@your-db-instance.xxxxxxxxxx.ap-south-1.rds.amazonaws.com:5432/carwash?sslmode=require

# Generate real random values - one each, do not reuse across environments:
#   openssl rand -hex 64
JWT_ACCESS_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME
JWT_RESET_SECRET=REPLACE_ME

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
RESET_TOKEN_EXPIRES_IN=30m

# Your real frontend domain(s), comma-separated. Never "*" in production.
CORS_ORIGIN=https://app.yourdomain.com

LOG_LEVEL=info

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
FORGOT_PASSWORD_RATE_LIMIT_MAX=5

# Wire a real provider into src/utils/mailer.ts's SmtpMailProvider before using this.
MAIL_PROVIDER=smtp
MAIL_FROM=no-reply@yourdomain.com
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
APP_PUBLIC_URL=https://app.yourdomain.com
