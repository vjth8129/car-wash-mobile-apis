# Parameters for stack vahanly-prod. Create with: scripts/create-stack.sh prod
# One Key=Value per line, no quotes.
# These values need a paid AWS plan: the free plan caps RDS backups at 1 day and may
# not allow Multi-AZ or db.t4g.small. Upgrade the account before creating prod.
InstanceType=t3.small
DBInstanceClass=db.t4g.small
DBMultiAZ=true
DBDeletionProtection=true
DBBackupRetentionDays=14
VpcCidr=10.50.0.0/16
# Set once DNS for this name points at the stack's Elastic IP (blank = nip.io hostname).
Domain=
CertEmail=
# Blank = fresh empty database.
DBSnapshotIdentifier=
# Must stay blank in production.
DevResetCode=
