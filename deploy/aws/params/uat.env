# Parameters for stack vahanly-uat (see deploy/aws/vahanly-stack.yml for all of them).
# One Key=Value per line, no quotes.
InstanceType=t3.small
DBInstanceClass=db.t4g.micro
DBMultiAZ=false
DBDeletionProtection=false
# The account is on the AWS free plan, which caps RDS backups at 1 day.
DBBackupRetentionDays=1
VpcCidr=10.40.0.0/16
# Blank = fresh empty database (seeded with demo data by `scripts/deploy.sh uat --seed`).
# The old UAT data is in snapshot vahanly-carwash-db-final-20261016 if ever needed -
# setting it here on an existing stack would REPLACE the database with that restore.
DBSnapshotIdentifier=
# Testers can reset passwords with this code.
DevResetCode=1111
